[
  {
    "name": "가로 드래그",
    "start": { "x": 0, "y": 0 },
    "moves": [[3, 0], [10, 1], [60, 2]],
    "frames": 0,
    "expect": { "axis": "y", "x": 0, "y": 0.6 }
  },
  {
    "name": "세로 드래그",
    "start": { "x": 0, "y": 0 },
    "moves": [[0, 4], [1, 12], [2, 80]],
    "frames": 0,
    "expect": { "axis": "x", "x": 0.8, "y": 0 }
  },
  {
    "name": "대각선 - 가로가 먼저 6px을 넘음",
    "start": { "x": 0, "y": 0 },
    "moves": [[2, 1], [4, 3], [7, 5], [20, 14], [35, 30]],
    "frames": 0,
    "expect": { "axis": "y", "x": 0, "y": 0.35 }
  },
  {
    "name": "대각선 - 세로가 먼저 넘으면 나중에 가로가 커져도 x축 유지",
    "start": { "x": 0, "y": 0 },
    "moves": [[1, 2], [3, 7], [60, 40]],
    "frames": 0,
    "expect": { "axis": "x", "x": 0.4, "y": 0 }
  },
  {
    "name": "임계값 안의 떨림은 무시",
    "start": { "x": 0, "y": 0 },
    "moves": [[2, -3], [-4, 5], [5, -5]],
    "frames": 0,
    "expect": { "axis": null, "x": 0, "y": 0 }
  },
  {
    "name": "90° 넘게 기울어진 상태에서 가로 드래그 - 방향 반전",
    "start": { "x": 2, "y": 0 },
    "moves": [[10, 0], [100, 0]],
    "frames": 0,
    "expect": { "axis": "y", "x": 2, "y": -1 }
  },
  {
    "name": "뒤집힌 상태에서 드래그 후 자동 회전 재개 - 같은 방향으로 이어짐",
    "start": { "x": 2, "y": 0 },
    "moves": [[100, 0]],
    "frames": 60,
    "expect": { "axis": "y", "x": 2, "y": -1.2 }
  }
]
